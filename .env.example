# Copy to .env.local and fill in.
#
# The Anthropic SDK resolves credentials in this order:
#   1. ANTHROPIC_API_KEY
#   2. ANTHROPIC_AUTH_TOKEN
#   3. a profile stored by `ant auth login`
#
# So if you've run `ant auth login`, you can leave this file empty entirely.
ANTHROPIC_API_KEY=

# Optional. Point at a proxy or a compatible gateway.
# ANTHROPIC_BASE_URL=https://api.anthropic.com
